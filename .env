# =========================================================
# Environment Configuration
# ---------------------------------------------------------
# This file contains environment variables used by
# the Next.js + Prisma + Supabase + Xendit application.
#
# References:
# - Next.js Environment Variables
#   https://nextjs.org/docs/app/building-your-application/configuring/environment-variables
# - Prisma Database Connection
#   https://www.prisma.io/docs/orm/reference/connection-urls
# - Supabase API Keys
#   https://supabase.com/docs/guides/api
# - Xendit Payment API
#   https://developers.xendit.co
# - Resend Email API
#   https://resend.com/docs
#
# NOTE:
# Variables prefixed with NEXT_PUBLIC_ are exposed
# to the browser by Next.js.
#
# Code: by Dwi Y
# =========================================================



# ---------------------------------------------------------
# Supabase Configuration (Frontend)
# ---------------------------------------------------------
# Source:
# Supabase Official Documentation
# https://supabase.com/docs/guides/api
#
# NEXT_PUBLIC_SUPABASE_URL
# The base URL of the Supabase project used by the client.
# Required for initializing Supabase client in frontend apps.
#
# Best practice:
# Use NEXT_PUBLIC_ prefix when variables must be accessible
# in the browser environment (Next.js requirement).
NEXT_PUBLIC_SUPABASE_URL=https://hflpwvrqggxhoadtwvte.supabase.co


# ---------------------------------------------------------
# Supabase Public API Key
# ---------------------------------------------------------
# Source:
# Supabase Official Documentation
#
# This key is safe to expose in frontend applications
# because it operates under Row Level Security (RLS).
#
# Best practice:
# Never expose the SERVICE_ROLE_KEY in frontend code.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImhmbHB3dnJxZ2d4aG9hZHR3dnRlIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzI3MjAyODMsImV4cCI6MjA4ODI5NjI4M30.sV-7UIyjmQQxBAJUH0hHjbWF_IIdmr_Hw84uQ3oI7U4



# ---------------------------------------------------------
# Prisma Database Connection
# ---------------------------------------------------------
# Source:
# Prisma Official Documentation
# https://www.prisma.io/docs/orm/reference/connection-urls
#
# DATABASE_URL is used by Prisma to connect to PostgreSQL.
#
# In Supabase deployments, Prisma usually connects through
# the Supabase connection pooler to prevent connection limits.
#
# Best practice:
# Use connection pooling in serverless environments
# such as Vercel to avoid database connection exhaustion.



# Alternative connection (commented)
# Uses Supabase pooler port 6543
# DATABASE_URL="postgresql://postgres.hflpwvrqggxhoadtwvte:6Vh9UBY8NK59L3sQ@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres"


# Active Prisma database connection
# Uses port 5432 with connection limit parameter.
#
# connection_limit=1 is recommended in serverless
# environments like Vercel to avoid too many connections.
DATABASE_URL="postgresql://postgres.hflpwvrqggxhoadtwvte:IluYgECDAfPHfEFq@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres?connection_limit=1"



# ---------------------------------------------------------
# Payment Gateway Configuration (Xendit)
# ---------------------------------------------------------
# Source:
# Xendit Developer Documentation
# https://developers.xendit.co
#
# This key is used on the backend server
# to create invoices and payment transactions.
#
# Security Best Practice:
# Never expose SECRET keys to the frontend.
XENDIT_SECRET_KEY=xnd_development_z11RvYbsz8B8XTz7lXHC4CEZEIwFA4XJqj0gkjqoC3Tq6faigRv2lWbOLeHh



# ---------------------------------------------------------
# Xendit Public Key (Frontend)
# ---------------------------------------------------------
# Used for frontend payment interactions such as
# tokenizing payment methods or redirect handling.
#
# According to Xendit documentation, public keys
# are safe to expose in client-side code.
NEXT_PUBLIC_XENDIT_KEYS=xnd_public_development_g5WKPw0rAhDZclnLiswqp_kl9qqhDr91qe_5V6uzu8jDIGSw7dwzLB6qycuGgy_7



# ---------------------------------------------------------
# Redirect URLs
# ---------------------------------------------------------
# Source:
# Next.js Deployment Guidelines
#
# These URLs define where users are redirected after
# completing actions such as authentication or payment.
#
# Best practice:
# Store environment-specific URLs in env files
# to support multiple environments (dev / staging / prod).



# Base redirect URL for application
NEXT_PUBLIC_REDIRECT_URL=https://next-ecommerce-4f23l5vkx-dwidy99s-projects.vercel.app


# Redirect URL after successful payment
NEXT_PUBLIC_REDIRECT_PAYMENT_URL=https://next-ecommerce-4f23l5vkx-dwidy99s-projects.vercel.app/payment/success



# ---------------------------------------------------------
# Email Service Configuration (Resend)
# ---------------------------------------------------------
# Source:
# Resend Email API Documentation
# https://resend.com/docs
#
# RESEND_API_KEY is used by the backend server
# to send transactional emails such as:
#
# - Email verification
# - Password reset
# - Order confirmation
#
# Security Best Practice:
# Keep API keys only on the server side.
RESEND_API_KEY=re_YHUgyF3i_GJUhZsySYBXsnDfxdHn5k1zt